# ============================================================
# DonorMatch — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# ── Django ───────────────────────────────────────────────────
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
BASE_URL=https://yourdomain.com

# ── Database (PostgreSQL) ────────────────────────────────────
POSTGRES_DB=donormatch
POSTGRES_USER=donormatch
POSTGRES_PASSWORD=strong-db-password-here
DATABASE_URL=postgres://donormatch:strong-db-password-here@db:5432/donormatch

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── ML Engine ────────────────────────────────────────────────
ML_CONFIDENCE_THRESHOLD=0.75
ML_AUTONOMOUS_MODE_THRESHOLD=50

# ============================================================
# INTEGRATION SOURCES
# Add as many sources as you need (SOURCE_1, SOURCE_2, ...)
# The app fans out to ALL enabled sources simultaneously.
# ============================================================

# ── Source 1 — N8N (primary) ─────────────────────────────────
SOURCE_1_NAME=N8N Production
SOURCE_1_TYPE=n8n
SOURCE_1_BASE_URL=https://adeola121.app.n8n.cloud/webhook-test/emergency-blood-request
SOURCE_1_API_KEY=
SOURCE_1_BLOOD_REQUEST_PATH=emergency-blood-request
SOURCE_1_AVAILABILITY_PATH=check-donor-availability
SOURCE_1_NOTIFY_PATH=notify-donor
SOURCE_1_ENABLED=true

# ── Source 2 — Second N8N instance or backup webhook ─────────
SOURCE_2_NAME=Backup Webhook
SOURCE_2_TYPE=webhook
SOURCE_2_BASE_URL=https://my-backup-service.com/hooks
SOURCE_2_API_KEY=optional-api-key
SOURCE_2_BLOOD_REQUEST_PATH=blood-request
SOURCE_2_AVAILABILITY_PATH=check-availability
SOURCE_2_NOTIFY_PATH=notify
SOURCE_2_ENABLED=false

# ── Source 3 — Custom REST API ────────────────────────────────
SOURCE_3_NAME=Custom Donor API
SOURCE_3_TYPE=rest_api
# Use full URL overrides if paths differ from a shared base
SOURCE_3_BLOOD_REQUEST_URL=https://api.mydonordb.com/v2/request-blood
SOURCE_3_AVAILABILITY_URL=https://api.mydonordb.com/v2/check-availability
SOURCE_3_NOTIFY_URL=https://api.mydonordb.com/v2/notify
SOURCE_3_API_KEY=my-api-key-here
SOURCE_3_ENABLED=false

# ── Source 4–10 — Add more as needed ─────────────────────────
# SOURCE_4_NAME=...
# SOURCE_4_BASE_URL=...
# SOURCE_4_ENABLED=false